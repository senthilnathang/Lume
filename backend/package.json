{
  "name": "lume-backend",
  "version": "2.0.0",
  "description": "Lume backend task gateway \u2014 NestJS runtime; explicit legacy commands retained during migration",
  "type": "module",
  "scripts": {
    "legacy:init": "tsx src/scripts/setup.ts",
    "legacy:seed": "node prisma/seed.js",
    "legacy:dev": "tsx watch --clear-screen=false src/index.js",
    "legacy:dev:nodemon": "nodemon src/index.js",
    "legacy:start": "node src/index.js",
    "legacy:dev:mysql": "DB_TYPE=mysql tsx watch --clear-screen=false src/index.js",
    "legacy:dev:postgres": "DB_TYPE=postgres tsx watch --clear-screen=false src/index.js",
    "legacy:build": "echo 'No build step required'",
    "legacy:test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "legacy:test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "legacy:lint": "eslint src/",
    "legacy:lint:fix": "eslint src/ --fix",
    "legacy:typecheck": "tsc --noEmit --skipLibCheck",
    "legacy:db:init": "node src/scripts/initDb.js --seed",
    "legacy:db:init:force": "node src/scripts/initDb.js --seed --force",
    "legacy:db:seed": "node prisma/seed.js",
    "legacy:db:admin": "node src/scripts/createAdmin.js",
    "legacy:db:refresh": "node src/scripts/refreshDb.js",
    "legacy:db:setup:drizzle": "node src/scripts/setupDrizzle.js",
    "legacy:db:setup": "node src/scripts/refreshDb.js && npx prisma db push --accept-data-loss && node src/scripts/setupDrizzle.js && node src/scripts/createAdmin.js && node src/scripts/seedData.js",
    "legacy:pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "legacy:pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "legacy:pm2:stop": "pm2 stop ecosystem.config.cjs",
    "legacy:pm2:logs": "pm2 logs lume-backend",
    "legacy:pm2:status": "pm2 status",
    "legacy:check": "npm run lint || true && npm run typecheck || true && NODE_OPTIONS='--experimental-vm-modules' jest tests/integration/setup-smoke.test.js tests/unit/websocket-permission.test.js tests/unit/schema-portability.test.js --forceExit",
    "legacy:clean": "rm -rf dist coverage .jest",
    "dev": "npm --prefix lume-nestjs run dev",
    "start": "npm --prefix lume-nestjs run start",
    "build": "npm --prefix lume-nestjs run build",
    "test": "npm --prefix lume-nestjs run test",
    "test:coverage": "npm --prefix lume-nestjs run test:cov",
    "lint": "npm --prefix lume-nestjs run lint",
    "lint:fix": "npm --prefix lume-nestjs run lint:fix",
    "typecheck": "npm --prefix lume-nestjs run typecheck",
    "db:generate": "npm --prefix lume-nestjs run db:generate",
    "db:migrate:sql": "npm --prefix lume-nestjs run db:migrate:sql",
    "verify:startup": "npm --prefix lume-nestjs run verify:startup",
    "setup": "npm --prefix lume-nestjs ci"
  },
  "dependencies": {
    "@bull-board/express": "^7.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.68.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-mysql2": "^0.66.0",
    "@opentelemetry/instrumentation-redis": "^0.68.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.75.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "imapflow": "^1.7.8",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "lodash-es": "^4.17.21",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.20.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.0",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "prisma": "^5.18.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^4.6.12",
    "samlify": "^2.13.1",
    "sharp": "^0.35.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "uuid": "^9.0.1",
    "winston": "^3.14.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/yargs": "^17.0.32",
    "drizzle-kit": "^0.31.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "yargs": "^17.7.2"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
