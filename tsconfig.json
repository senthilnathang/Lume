{
  "extends": "./packages/@lume/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@lume/*": ["packages/@lume/*/src"],
      "@backend/*": ["apps/api/src/*"],
      "@modules/*": ["packages/@lume/module-ui/src/modules/*"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.vue",
    "packages/**/*.ts"
  ],
  "exclude": ["node_modules", "legacy", "**/dist", "**/.nuxt", "**/.output"]
}
