# Local configuration template. Supply real credentials outside version control.
DATABASE_URL=mysql://lume:CHANGE_ME@127.0.0.1:3306/lume
JWT_SECRET=CHANGE_ME
PORT=3000

# Explicit deployment-owned runtime entrypoints; relative to the API working directory.
MODULES_ENABLED=true
LOAD_EXAMPLE_MODULES=false
MODULE_ENTRYPOINTS=[]
# Example: [{"specifier":"./dist/extensions/acme.module.js","export":"AcmeModule"}]
# Automatic module migrations are unsupported; apply the reviewed SQL plan first.
AUTO_MIGRATE_MODULES=false
VERBOSE_MODULE_LOGGING=false

# Apply and verify migrations 014–015 before enabling the worker.
# Without this setting the runtime enables polling by default.
AUTOMATION_WORKER_ENABLED=false
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_DURABLE_EVENTS=false

# Optional external integrations remain disabled until configured.
# Gateways must accept JSON POST requests and honor the idempotency-key header.
WORKFLOW_DELIVERY_HOSTS=
WORKFLOW_EMAIL_GATEWAY_URL=
WORKFLOW_EMAIL_GATEWAY_TOKEN=
WORKFLOW_PUSH_GATEWAY_URL=
WORKFLOW_PUSH_GATEWAY_TOKEN=
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
