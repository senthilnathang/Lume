{
  "name": "@lume/api",
  "version": "2.0.0",
  "description": "Lume Framework v2.0 - NestJS Backend",
  "author": "Lume Team",
  "license": "MIT",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main",
    "build": "nest build",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --config .eslintrc.json src",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint --config .eslintrc.json src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node scripts/seed.js",
    "docker:build": "docker build -f apps/api/Dockerfile -t lume-api:latest ../..",
    "docker:up": "docker compose --project-directory ../.. up -d",
    "db:generate": "prisma generate",
    "prebuild": "pnpm run db:generate",
    "pretypecheck": "pnpm run db:generate",
    "db:migrate:sql": "tsx migrations/run-migrations.ts",
    "verify:startup": "node scripts/verify-startup.cjs",
    "verify:framework-db": "tsx scripts/framework-preflight.ts",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage"
  },
  "dependencies": {
    "@apollo/server": "^4.13.0",
    "@nestjs/apollo": "13.1.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/graphql": "^13.4.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@prisma/client": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.76.4",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.15.1",
    "cron-parser": "4.9.0",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.4",
    "expr-eval": "^2.0.2",
    "express": "^5.3.0",
    "graphql": "^16.13.2",
    "graphql-query-complexity": "^2.0.0",
    "graphql-scalars": "^1.25.0",
    "graphql-subscriptions": "3.0.0",
    "graphql-ws": "^5.16.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.24.6",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "qrcode": "^1.5.4",
    "redis": "^4.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "dotenv": "^17.4.1",
    "eslint": "^8.57.1",
    "jest": "^29.0.0",
    "prettier": "^3.9.10",
    "prisma": "^5.0.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0",
    "ws": "^8.22.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "prisma",
    "migrations",
    "scripts",
    "deploy"
  ]
}
