# Root configuration is for Docker Compose only.
# Local API settings belong in apps/api/.env (see its .env.example).
DB_NAME=lume
DB_USER=lume
DB_PASSWORD=
DB_ROOT_PASSWORD=
JWT_SECRET=
# URL-encode credentials. Docker's database hostname is db.
DATABASE_URL=
# This public URL must be reachable from browsers AND the website container.
NUXT_PUBLIC_API_BASE=
NUXT_PUBLIC_SITE_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:8080,http://localhost:3100
API_PORT=3000
ADMIN_PORT=8080
WEBSITE_PORT=3100
